# 复制本文件为 .env，把下面两处 Key 替换成你自己的，然后即可运行
# 提示：保持 sk- 前缀；未替换成真实 Key 时会得到 401（而不是编码错误）

# ---- 模型：DeepSeek（OpenAI 兼容接口） ----
DEEPSEEK_API_KEY=sk-REPLACE_WITH_YOUR_DEEPSEEK_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- 千问AI平台 MCP 服务（联网搜索 EnhancedSearch + 网页抓取 WebFetch） ----
# 未配置或服务不可用时，工具会自动降级为本地实现（Bing 检索 / requests+lxml 抓取）
DASHSCOPE_API_KEY=sk-REPLACE_WITH_YOUR_DASHSCOPE_KEY
