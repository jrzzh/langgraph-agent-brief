# ============================================================
# 1) 密钥与本地配置 —— 最重要，切勿提交
# ============================================================
.env
.env.local
.env.*.local
*.key
*.pem

# ============================================================
# 2) Python 虚拟环境与缓存（体积大、与本机路径绑定）
# ============================================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ============================================================
# 3) uv 缓存（本项目实测约 183 MB）
# 注意：uv.lock 必须提交！它是可复现性的关键，不要忽略
# ============================================================
.uv-cache/

# tiktoken 词表缓存：默认写 tempfile.gettempdir()，但 TEMP 不可用时 Python 会退回
# 当前工作目录并在仓库根生成 data-gym-cache/，故两条都忽略
.cache/
data-gym-cache/

# ============================================================
# 4) Office / 编辑器 / 系统临时文件
#     ~$* 用于排除 Excel/Word 打开文件时生成的锁文件
# ============================================================
~$*
*.tmp
*.bak
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 5) 校验用临时产物
# ============================================================
*_check.json
xlsx_check.json

# ============================================================
# 6) 交付文档 —— **提交**（课题交付物，随仓库分发）
#    00-交付总览.md ~ 06-单框架实测填表数据.xlsx、07-交付报告.docx
#    .env / .venv / .uv-cache 等本机文件仍不提交
# ============================================================

# ============================================================
# 7) 填表数据生成脚本 —— **提交**（需能从仓库重新生成 06-*.xlsx）
#    个人署名通过环境变量 REPORT_AUTHOR 注入，代码中不含个人信息
# ============================================================

# ============================================================
# 8) 测试记录 —— logs/ 与 output/ 属于「测试记录」，**保留提交**
#     其中的本机绝对路径已脱敏为相对路径
# ============================================================
# logs/
# output/

# workspace：sources 素材入库，briefs 是运行产物（与 output/ 重复，不入库）
workspace/briefs/*
!workspace/briefs/.gitkeep
